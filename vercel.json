{
  "builds": [
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.php",
      "use": "vercel-php@0.7.3"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/proses.php",
      "dest": "/proses.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
